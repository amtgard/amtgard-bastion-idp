# --- Non-secret config vs vault inject ---
# Keep hosts, ports, client IDs, feature flags, and TTLs in this file (or the host `.env` copy).
# Sensitive values (DB password, Defuse key, ORK shared secret, OAuth PEMs, mail API keys, etc.)
# belong in host-env-vault profile env + inject_files, rendered under `/run/secrets` on the host.
# Compose sets `HOST_ENV_SECRETS_DIR=/run/secrets` and mounts:
#   web:    IDP_HEV_HTTP_SECRETS   (see GB_HEV_MOUNT_MAP in `.greenblue.example.*`)
#   worker: IDP_HEV_WORKER_SECRETS
# Injected `secrets.env` loads after this file and does not override keys already set here.
# Local dev without vault: plain defaults below; export IDP_LEGACY_DEV_KEYS=./dev-keys (and keys/) for PEM bind mounts.
# See host-env/README.md and host-env/secrets.example/.

# Application settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:37080
APP_SECRET=change_this_to_a_random_string

# Database settings
# Local Docker: DB_HOST=amtgard-idp-db (MariaDB in the web compose overlay)
# Production: DB_HOST=host.docker.internal or your MySQL host
DB_DRIVER=pdo_mysql
DB_HOST=amtgard-idp-db
DB_PORT=3306
DB_NAME=idp
DB_USER=idp
DB_PASS=secret

# Pub/sub queue and JWT validation cache Redis.
# Local Docker and production: amtgard-idp-sessions (isolated Redis), DB 0
REDIS_PUBSUB_HOST=amtgard-idp-sessions
REDIS_PUBSUB_PORT=6379
REDIS_PUBSUB_DB=0
REDIS_PUBSUB_QUEUE_NAME=amtgard-idp
# Dedicated JWT PVH refresh SetQueue (not the presence queue above).
REDIS_PVH_QUEUE_NAME=amtgard-idp-pvh

# PHP sessions. Leave SESSION_REDIS_HOST empty for file-based sessions outside Docker.
# Local Docker and production: amtgard-idp-sessions, DB 1.
SESSION_REDIS_HOST=amtgard-idp-sessions
SESSION_REDIS_PORT=6379
SESSION_REDIS_DB=1
SESSION_REDIS_PREFIX=PHPSESS:

JWT_KEY=jwt_key
AUTH_SERVER_DEFUSE_KEY=auth_server_defust_key

# OAuth settings (local bind-mount paths; vault inject uses /run/secrets/files/oauth-*.key via secrets.env)
OAUTH_PRIVATE_KEY=/var/www/idp.amtgard.com/dev-keys/private.key
OAUTH_PUBLIC_KEY=/var/www/idp.amtgard.com/dev-keys/public.key
OAUTH_ENCRYPTION_KEY=change_this_to_a_random_string
OAUTH_AUTH_TOKEN_TTL=PT10M
OAUTH_ACCESS_TOKEN_TTL=PT2H
OAUTH_REFRESH_TOKEN_TTL=P1M

# Google OAuth settings
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:37080/auth/google/callback

# Facebook OAuth settings
FACEBOOK_CLIENT_ID=facebook_client_id
FACEBOOK_CLIENT_SECRET=facebook_client_secret
FACEBOOK_REDIRECT_URI=http://localhost:37080/auth/facebook/callback

# Discord OAuth settings
DISCORD_CLIENT_ID=discord_client_id
DISCORD_CLIENT_SECRET=discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:37080/auth/discord/callback

# Apple Sign In (set APPLE_LOGIN_ENABLED=true and configure credentials below)
APPLE_LOGIN_ENABLED=false
APPLE_CLIENT_ID=apple_service_id
APPLE_TEAM_ID=apple_team_id
APPLE_KEY_FILE_ID=apple_key_id
APPLE_KEY_FILE_PATH=/path/to/AuthKey_XXXXXX.p8
APPLE_REDIRECT_URI=http://localhost:37080/auth/apple/callback

MANAGEMENT_KEY=MANAGEMENTKEY
# ORK Service settings
ORK_API_USER_AGENT="bogus_user_agent"
ORK_API_REFERER="bogus_referer"

# Shared HS256 secret with ORK3 for /auth/connect handoff JWT verification,
# the completion-token signing, and the /resources/link-ork-profile mirror
# endpoint. Must match ORK's IDP_ORK_SHARED_SECRET byte-for-byte.
# 32+ random bytes, base64. Generate with: openssl rand -base64 48
#
# The legacy name ORK_LINK_TOKEN_SECRET is still read as a fallback during
# the rename transition; new deploys should set IDP_ORK_SHARED_SECRET only.
IDP_ORK_SHARED_SECRET=

# Where the IDP redirects users back to after a successful /auth/connect flow.
ORK_BASE_URL=http://localhost:19080/orkui/

# When 1 or true, Flow A Email Code asks ORK to mail the claim code (BeginClaimOrkMail)
# instead of calling tokenless GetPlayer and sending from the IDP.
ORK_CLAIM_MAIL_VIA_ORK=

# Local ORK3 container (Docker network amtgard-idp-shared). Unset in production.
# ORK_JSON_API_BASE_URL=http://ork3-php8-app/orkservice/Json/index.php

# Comma-separated client_ids allowed to call POST /resources/link-ork-profile.
# Should be only the ORK confidential client(s).
LINK_ORK_PROFILE_ALLOWED_CLIENT_IDS=

# Structured logging (spool + hourly SQLite). Prefer LOG_ROOT outside cloud-synced paths.
# LOG_ROOT=logs/bundles
# LOG_SPOOL_ENABLED=true
# LOG_STDERR_ENABLED=true
# LOG_TRACE_LEVEL=debug
# LOG_WRITER_SLEEP_MS=200

# HMAC pepper for mailbox possession codes. Never log the raw code.
# Generate with: openssl rand -hex 32
MAILBOX_CODE_PEPPER=

# Outbound mail carrier: log (default), php, sendgrid, or ses.
# log records sent_to_hash and subject only. php uses PHP mail().
MAIL_TRANSPORT=

# SendGrid v3 mail/send. Required when MAIL_TRANSPORT=sendgrid.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# AWS SES SMTP on port 587. Required when MAIL_TRANSPORT=ses.
# AMAZON_SES_FROM_EMAIL must be a verified sender. Optional AMAZON_SES_PORT defaults to 587.
AMAZON_SES_HOST=
AMAZON_SES_USERNAME=
AMAZON_SES_PASSWORD=
AMAZON_SES_FROM_EMAIL=

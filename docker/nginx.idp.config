server {
    listen 80;
    server_name _;

    root /var/www/idp.amtgard.com/public;
    index index.htm index.html index.php;

    add_header Access-Control-Allow-Origin *;

    # Docsify lives in Slim (/docs, /docs/readme.md). A physical public/docs/ directory
    # (for example a symlink to the repo docs/ runbook) makes try_files serve the folder
    # and returns 403/404 before PHP — route these paths to the front controller first.
    location = /docs {
        rewrite ^ /index.php?$query_string last;
    }

    location = /docs/ {
        rewrite ^ /index.php?$query_string last;
    }

    location ^~ /docs/ {
        try_files $uri /index.php?$query_string;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.4-fpm.sock;
    }

    location ~* \.(jpg|gif|png) {
        add_header Cache-Control "public, max-age=300, must-revalidate";
    }
}

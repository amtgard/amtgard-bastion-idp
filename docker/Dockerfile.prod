FROM dunglas/frankenphp:1-php8.4-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends git unzip \
    && rm -rf /var/lib/apt/lists/*

RUN install-php-extensions \
    @composer \
    pdo_mysql \
    redis \
    gd \
    zip \
    opcache \
    mbstring \
    xml \
    curl

# CVE-2026-109618 / CVE-2026-109619 — PHP 8.4.27+ (2026-10-21). Rebuild images after base image updates.
RUN php -r '$v=PHP_VERSION; if (version_compare($v, "8.4.27", "<")) { fwrite(STDERR, "Require PHP >= 8.4.27, got {$v}\n"); exit(1); }'

COPY docker/php-frankenphp.ini /usr/local/etc/php/conf.d/99-idp.ini

ENV COMPOSER_ALLOW_SUPERUSER=1
ENV FRANKENPHP_NUM=2
ENV ENVIRONMENT=PROD

WORKDIR /var/www/idp.amtgard.com

COPY composer.json composer.lock ./
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-scripts

COPY . .
RUN mkdir -p logs cache/twig cache/di \
    && chown -R www-data:www-data /var/www/idp.amtgard.com

COPY docker/Caddyfile /etc/caddy/Caddyfile

WORKDIR /var/www

COPY docker/frankenphp-entrypoint.sh /usr/local/bin/idp-frankenphp-entrypoint.sh
RUN chmod +x /usr/local/bin/idp-frankenphp-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/idp-frankenphp-entrypoint.sh"]
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]

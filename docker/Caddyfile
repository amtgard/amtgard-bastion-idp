{
	admin off

	frankenphp {
		max_requests 500
		php_ini variables_order "EGPCS"
		php_ini memory_limit "128M"
		php_ini session.gc_maxlifetime "2592000"
		php_ini session.cookie_lifetime "2592000"
		php_ini session.upload_progress.enabled "0"
		php_ini opcache.enable "1"
		php_ini opcache.validate_timestamps "0"
	}
}

:80 {
	root * /var/www/idp.amtgard.com/public
	encode zstd gzip

	route {
		# Docsify lives in Slim (/docs, /docs/readme.md). A physical public/docs/
		# directory (for example a symlink to the repo docs/ runbook) would make
		# try_files serve the folder before PHP — route these paths to the worker
		# with the original URI intact, so Slim sees /docs, not /index.php.
		# Do NOT rewrite to /index.php: a rewrite loses the /docs URI and, worse,
		# lets the static-file handle serve the front controller's source.
		# try_files fallbacks are bare file paths: FrankenPHP checks the
		# fallback as a file on disk, so /index.php{query} mangles to a
		# nonexistent path with a query string, and /index.php?{query}
		# 404s every request (the trailing '?' is part of the path it
		# checks). The worker receives the original request URI, query
		# string included, so plain /index.php is correct — unlike
		# php_fastcgi, nothing needs re-appending.
		@docs path /docs /docs/*
		handle @docs {
			php_server {
				try_files /index.php
				worker {
					file /var/www/idp.amtgard.com/bin/http-worker.php
					num {$FRANKENPHP_NUM:2}
				}
			}
		}

		# Static assets are served from disk, but never a .php file: a .php file
		# must always reach the worker, otherwise Caddy serves its source raw.
		@static {
			file
			not path *.php
		}
		handle @static {
			@cachedImages path_regexp cachedImages \.(jpg|gif|png|jpeg)$
			header @cachedImages Cache-Control "public, max-age=300, must-revalidate"
			file_server
		}

		handle {
			php_server {
				try_files {path} {path}/ /index.php
				worker {
					file /var/www/idp.amtgard.com/bin/http-worker.php
					num {$FRANKENPHP_NUM:2}
				}
			}
		}
	}
}

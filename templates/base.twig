<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Amtgard Identity Provider{% endblock %}</title>
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico"/>
    <link rel="stylesheet" href="/assets/idp.css"/>
    {% block styles %}{% endblock %}
</head>
<body class="font-sans leading-relaxed m-0 p-5 text-gray-800 bg-gray-50 min-h-screen">
    <div class="{% block container_class %}max-w-[800px]{% endblock %} mx-auto bg-white p-6 rounded-lg shadow-sm">
        {% block content %}{% endblock %}
    </div>
    <p class="mt-6 text-center text-xs text-gray-400">{{ appVersion }}</p>
    {% block scripts %}{% endblock %}
</body>
</html>

{% extends "base.twig" %}

{% block title %}Register - Amtgard Identity Provider{% endblock %}

{% block content %}
<div class="max-w-[800px] mx-auto">
    <div class="md:flex md:gap-8 md:items-start">
        <!-- Desktop Logo -->
        <div class="hidden md:block flex-shrink-0">
             <a href="/"><img src="/images/idp_logo_small.jpeg" alt="Amtgard IDP Logo" class="rounded-lg"></a>
        </div>

        <div class="flex-grow max-w-[500px]">
            <h1 class="text-3xl font-serif font-bold text-secondary text-center mb-3">Create your Amtgard Sign-In</h1>
            <p class="text-sm text-gray-600 text-center mb-2 leading-snug">
              One sign-in for all Amtgard digital services &mdash; the ORK, event apps, and more.
              Sign in once here, then connect your existing player profile.
            </p>
            <div class="bg-blue-50 border border-blue-200 rounded p-3 mb-5 text-xs text-blue-900 leading-snug">
              <strong>Already have an ORK player record?</strong> That&rsquo;s separate &mdash; created by your park officers.
              You&rsquo;ll connect it to this sign-in on the next step.
            </div>
            
            <div class="flex justify-center mb-6 md:hidden">
                <a href="/"><img src="/images/idp_logo_tiny.jpeg" alt="Amtgard IDP Logo" class="rounded shadow-sm"></a>
            </div>
            
            <div class="text-center mb-6">
                <div class="space-y-2 mb-4">
                    <a href="/auth/google" class="block w-full bg-[#DB4437] hover:bg-[#c53929] text-white py-2.5 rounded transition-colors duration-200 decoration-0"><i class="fa-brands fa-google mr-2"></i>Google</a>
                    <a href="/auth/facebook" class="block w-full bg-[#4267B2] hover:bg-[#365899] text-white py-2.5 rounded transition-colors duration-200 decoration-0"><i class="fa-brands fa-facebook mr-2"></i>Facebook</a>
                    <a href="/auth/discord" class="block w-full bg-[#5865F2] hover:bg-[#4752c4] text-white py-2.5 rounded transition-colors duration-200 decoration-0"><i class="fa-brands fa-discord mr-2"></i>Discord</a>
                    {% if appleLoginEnabled %}
                    <a href="/auth/apple" class="block w-full bg-black hover:bg-gray-900 text-white py-2.5 rounded transition-colors duration-200 decoration-0"><i class="fa-brands fa-apple mr-2"></i>Apple</a>
                    {% endif %}
                </div>
                
                <button type="button" onclick="toggleRegister()" class="group flex items-center justify-center gap-2 mx-auto text-gray-600 hover:text-gray-800 transition-colors focus:outline-none">
                    <span>Register with Email</span>
                    <!-- Default state: Point UP (rotate-180) -->
                    <svg id="register-chevron" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-300 transform rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>
            </div>

            <div id="register-form-container" class="max-h-0 overflow-hidden transition-all duration-500 ease-in-out opacity-0"></div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    const REGISTER_FORM_HTML = `
        {% if error %}<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">{{ error|e('js') }}</div>{% endif %}
        <form action="/auth/register" method="post" class="mb-6">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
            <div class="mb-4">
                <input type="text" id="firstName" name="firstName" required placeholder="First Name" value="{{ firstName|e }}" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
            </div>
            <div class="mb-4">
                <input type="text" id="lastName" name="lastName" required placeholder="Last Name" value="{{ lastName|e }}" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
            </div>
            <div class="mb-4">
                <input type="email" id="email" name="email" required placeholder="Email" value="{{ email|e }}" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
            </div>
            <div class="mb-4">
                <input type="password" id="password" name="password" required placeholder="Password" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
            </div>
            <div class="mb-6">
                <input type="password" id="confirmPassword" name="confirmPassword" required placeholder="Confirm Password" oninput="this.setCustomValidity(this.value !== this.form.querySelector('[name=password]').value ? 'Passwords do not match' : '')" class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
            </div>
            <button type="submit" class="w-full bg-primary hover:bg-primary-dark text-white font-medium py-2.5 px-4 rounded transition-colors duration-200">Register</button>
        </form>
        <div class="text-center mt-8 pt-4 border-t border-gray-100">
            <p class="text-gray-600">Already have an account? <a href="/auth/login?expand=1" class="text-primary hover:text-primary-dark font-medium hover:underline">Login</a></p>
        </div>
    `;

    function toggleRegister() {
        const container = document.getElementById('register-form-container');
        const icon = document.getElementById('register-chevron');

        if (container.style.maxHeight) {
            container.style.maxHeight = null;
            container.classList.remove('opacity-100');
            container.classList.add('opacity-0');
            icon.classList.add('rotate-180');
            setTimeout(() => { container.innerHTML = ''; }, 500);
        } else {
            container.innerHTML = REGISTER_FORM_HTML;
            requestAnimationFrame(() => {
                container.style.maxHeight = container.scrollHeight + "px";
                container.classList.remove('opacity-0');
                container.classList.add('opacity-100');
                icon.classList.remove('rotate-180');
            });
        }
    }

    {% if error or expand %}
    document.addEventListener('DOMContentLoaded', toggleRegister);
    {% endif %}
</script>
{% endblock %}
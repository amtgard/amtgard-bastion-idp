#!/usr/bin/env bash
set -euo pipefail

# post-commit amends once to include VERSION files with the real commit SHA.
if [[ "${AMTGARD_VERSION_AMEND:-}" == "1" ]]; then
    exit 0
fi

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    exit 0
fi

"${ROOT}/scripts/write-version.sh"

git add VERSION version.json

if git diff --cached --quiet; then
    exit 0
fi

AMTGARD_VERSION_AMEND=1 git commit --amend --no-edit --no-verify
